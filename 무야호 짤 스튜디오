① index.html — 편집 화면
<!doctype html>
<html lang="ko" translate="no">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="google" content="notranslate">
  <meta
    name="description"
    content="무야호 사진에 나만의 문구를 넣고 PNG로 저장하세요. 이미지 편집, 템플릿 관리와 JSON 백업."
  >

  <title>무야호! 짤 스튜디오</title>

  <link
    rel="icon"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23f4ca46'/%3E%3Ctext x='16' y='23' text-anchor='middle' font-size='24' font-weight='bold'%3EM%3C/text%3E%3C/svg%3E"
  >

  <link rel="stylesheet" href="style.css">
  <script src="core.js" defer></script>
  <script src="app.js" defer></script>
</head>

<body>
  <header>
    <a class="brand" href="./">
      <b>M!</b>
      <span>무야호! <em>짤 스튜디오</em></span>
    </a>

    <nav>
      <button id="templatesTab">
        내 템플릿 <span id="count">0</span>
      </button>

      <button id="download" class="primary">
        PNG 내려받기 ↓
      </button>
    </nav>
  </header>

  <main>
    <section class="heading">
      <div>
        <span class="eyebrow">MAKE IT YOUR MOMENT</span>
        <h1>이 순간, 무야호!</h1>
        <p>사진 한 장에 내 상황을 더하면, 오늘의 짤 완성.</p>
      </div>

      <span class="local-note">
        내 사진과 템플릿은 이 브라우저에만 저장돼요.
      </span>
    </section>

    <div class="workspace">
      <aside class="panel editor">
        <div class="panel-title">
          <span>01</span>
          <h2>사진 & 문구</h2>
        </div>

        <label class="upload" for="imageFile">
          <strong>＋ 내 사진 불러오기</strong>
          <small>PNG · JPEG / 최대 10MB</small>
        </label>

        <input
          type="file"
          id="imageFile"
          accept="image/png,image/jpeg"
          hidden
        >

        <div class="image-actions">
          <button id="defaultImage">무야호 원본</button>

          <label for="fit">사진 맞춤</label>

          <select id="fit">
            <option value="contain">전체 보이기</option>
            <option value="cover">꽉 채우기</option>
          </select>
        </div>

        <div
          class="text-tabs"
          role="group"
          aria-label="편집할 문구"
        >
          <button
            data-layer="top"
            class="active"
            aria-pressed="true"
          >
            위 문구
          </button>

          <button
            data-layer="bottom"
            aria-pressed="false"
          >
            아래 문구
          </button>
        </div>

        <label for="caption">어떤 순간인가요?</label>

        <textarea
          id="caption"
          maxlength="2000"
          rows="3"
        ></textarea>

        <div class="caption-meta">
          <span>줄바꿈·이모지 사용 가능</span>
          <span id="chars">0 / 2000</span>
        </div>

        <div class="slider-heading">
          <label for="fontSize">글자 크기</label>
          <output id="sizeValue">64</output>
        </div>

        <input
          id="fontSize"
          type="range"
          min="20"
          max="160"
          step="1"
        >

        <div class="slider-heading">
          <label for="textX">가로 위치</label>
          <output id="xValue">50%</output>
        </div>

        <input
          id="textX"
          type="range"
          min="15"
          max="85"
        >

        <div class="slider-heading">
          <label for="textY">세로 위치</label>
          <output id="yValue">7%</output>
        </div>

        <input
          id="textY"
          type="range"
          min="0"
          max="85"
        >

        <div class="color-row">
          <label for="textColor">
            글자 색
            <input id="textColor" type="color">
          </label>

          <label for="bgColor">
            배경 색
            <input id="bgColor" type="color">
          </label>
        </div>

        <label class="check">
          <input id="outline" type="checkbox" checked>
          글자 테두리
        </label>

        <p class="fine">
          긴 문구는 영역에 맞춰 자동으로 작아집니다.
        </p>
      </aside>

      <section class="preview-panel">
        <div class="preview-top">
          <span class="eyebrow">LIVE PREVIEW</span>
          <span id="dimensions">1080 × 1080</span>
        </div>

        <div class="canvas-stage">
          <canvas
            id="canvas"
            width="1080"
            height="1080"
            aria-label="편집 이미지 미리보기"
          ></canvas>
        </div>

        <div
          class="ratio-tabs"
          role="group"
          aria-label="화면 비율"
        >
          <button
            data-ratio="1:1"
            class="active"
            aria-pressed="true"
          >
            <i class="r-square"></i>
            1:1 <small>정사각형</small>
          </button>

          <button
            data-ratio="4:5"
            aria-pressed="false"
          >
            <i class="r-portrait"></i>
            4:5 <small>게시물</small>
          </button>

          <button
            data-ratio="9:16"
            aria-pressed="false"
          >
            <i class="r-story"></i>
            9:16 <small>스토리</small>
          </button>
        </div>

        <p id="notice" role="status">
          이미지를 준비하고 있어요.
        </p>

        <p id="fitNotice" class="fine"></p>
      </section>

      <aside class="panel inspiration">
        <div class="panel-title">
          <span>02</span>
          <h2>바로 써먹는 문구</h2>
        </div>

        <p class="muted">
          지금 내 상황에 맞는 한 줄을 골라봐요.
        </p>

        <button class="preset" data-preset="0">
          <span>⌘ 코딩하는 날</span>
          <strong>
            오류 30개 잡고<br>
            드디어 실행됐을 때
          </strong>
          <small>문구 적용 ↗</small>
        </button>

        <button class="preset" data-preset="1">
          <span>☀ 퇴근하는 날</span>
          <strong>
            퇴근 1분 전<br>
            추가 업무가 없을 때
          </strong>
          <small>문구 적용 ↗</small>
        </button>

        <button class="preset" data-preset="2">
          <span>✓ 해낸 날</span>
          <strong>
            미루던 일<br>
            드디어 끝냈을 때
          </strong>
          <small>문구 적용 ↗</small>
        </button>

        <div class="save-box">
          <h3>이 조합, 저장해둘까요?</h3>

          <label for="templateName" class="sr-only">
            템플릿 이름
          </label>

          <input
            id="templateName"
            maxlength="60"
            placeholder="예: 코딩 성공 무야호"
          >

          <button id="saveNew">
            내 템플릿에 저장 ＋
          </button>

          <p>사진·문구·색·위치를 함께 기억해요.</p>
        </div>
      </aside>
    </div>

    <section id="templateSection" class="lower" hidden>
      <div class="section-top">
        <div>
          <span class="eyebrow">SAVED BY YOU</span>
          <h2>내 템플릿</h2>
        </div>

        <div class="actions">
          <button id="exportJson">JSON 내보내기</button>
          <button id="importJson">JSON 가져오기</button>

          <input
            id="jsonFile"
            type="file"
            accept=".json,application/json"
            hidden
          >
        </div>
      </div>

      <p class="muted">
        불러온 템플릿을 편집한 뒤 ‘수정 저장’을 누르세요.
        새 이름으로 추가하려면 위의 저장 버튼을 사용하세요.
      </p>

      <div id="templateList"></div>
    </section>

    <section class="details-row">
      <details>
        <summary>이미지 출처 기록</summary>

        <p>
          기본 사진: 사용자가 제공한 「무한도전」 방송 캡처.
          원본 출처 URL과 사용 허가 근거는 아직 제공되지 않았습니다.
          다운로드한 이미지가 자동으로 본인 제작이 되는 것은 아닙니다.
        </p>

        <label for="origin">
          원본 출처 URL 또는 본인 제작 설명
        </label>

        <input
          id="origin"
          maxlength="500"
          placeholder="원본 URL 또는 직접 촬영·제작한 설명"
        >

        <label for="license">사용 허가 근거</label>

        <input
          id="license"
          maxlength="300"
          placeholder="라이선스명·이용약관·수업 제공 표기 등"
        >

        <p>
          기록은 템플릿 JSON에 함께 저장됩니다.
          원본의 위치 정보 등 메타데이터는 이미지를 다시 그려 제거합니다.
        </p>
      </details>

      <details>
        <summary>완성 예시 3개</summary>

        <p>
          서로 다른 문구·비율의 PNG 예시입니다.
          기본 방송 캡처의 사용 허가 근거는 확인 전입니다.
        </p>

        <div class="samples">
          <a href="sample-square.png" target="_blank">
            1:1 · 코딩 성공 ↗
          </a>

          <a href="sample-feed.png" target="_blank">
            4:5 · 퇴근 성공 ↗
          </a>

          <a href="sample-story.png" target="_blank">
            9:16 · 할 일 완료 ↗
          </a>
        </div>
      </details>

      <details>
        <summary>검사와 제출 안내</summary>

        <p>
          <a href="checks.html" target="_blank">
            12개 입력 검사 결과 보기 ↗
          </a>
          ·
          <a href="source.html" target="_blank">
            전체 소스 보기 ↗
          </a>
          ·
          <a href="source.zip" download>
            소스 ZIP 받기 ↓
          </a>
        </p>

        <p>
          <b>어디로 가나요:</b>
          이 편집기 주소를 새 시크릿 창에서 엽니다.<br>

          <b>무엇을 하나요:</b>
          ① 이미지 선택 ② 문구·비율 편집 ③ PNG 내려받기.<br>

          <b>무엇이 보이면 통과:</b>
          미리보기와 파일의 배치가 같고,
          저장한 템플릿이 새로고침 뒤 유지됩니다.<br>

          <b>안 될 때:</b>
          잘못된 이미지·JSON의 거부 이유가 표시되고
          기존 작업은 유지됩니다.
        </p>

        <p>
          <b>AI에게 맡긴 일:</b>
          편집기·내려받기·템플릿 관리·검증 구현.<br>

          <b>직접 판단한 일:</b>
          무야호 소재 선택과 사용할 이미지 제공.<br>

          <b>AI 제안을 따르지 않은 일:</b>
          현재 확인된 사항 없음.
          초기 구현을 확인하고 문구·배치를 직접 조정할 예정입니다.
        </p>
      </details>
    </section>

    <footer>
      <span>무야호! 짤 스튜디오</span>
      <span>이미지를 서버로 업로드하지 않습니다.</span>
    </footer>
  </main>
</body>
</html>

② style.css — 디자인
@font-face {
  font-family: "Meme Sans";
  src: url("meme-font.woff") format("woff");
  font-weight: 900;
  font-display: block;
}

:root {
  --bg: #f5f4ef;
  --ink: #252522;
  --muted: #7b7b72;
  --line: #e4e2d9;
  --yellow: #f4ca46;
  --white: #fff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font: 15px/1.6 Arial, "Noto Sans KR", sans-serif;
  color: var(--ink);
  background: var(--bg);
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 9px 14px;
  background: white;
  color: var(--ink);
}

button:hover {
  border-color: #8a897f;
}

button:disabled {
  cursor: wait;
  opacity: 0.5;
}

button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible,
a:focus-visible {
  outline: 3px solid #baa023;
  outline-offset: 3px;
}

a {
  color: inherit;
}

header {
  height: 83px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: white;
  padding: 0 38px;
  border-bottom: 1px solid var(--line);
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;
  text-decoration: none;
  font-size: 21px;
  font-weight: 900;
  letter-spacing: -1px;
}

.brand > b {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 11px;
  background: var(--yellow);
  font: bold 25px Arial;
  transform: rotate(-6deg);
}

.brand em {
  font-style: normal;
  font-weight: 400;
  color: var(--muted);
}

nav {
  display: flex;
  gap: 10px;
}

.primary {
  background: var(--yellow);
  border-color: var(--yellow);
  font-weight: 700;
}

#count {
  background: #efeee8;
  padding: 2px 6px;
  border-radius: 5px;
  margin-left: 6px;
  font-size: 12px;
}

main {
  max-width: 1560px;
  padding: 0 38px;
  margin: auto;
}

.heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  padding: 28px 0 25px;
}

.eyebrow {
  font: 11px monospace;
  letter-spacing: 2px;
  color: var(--muted);
}

h1 {
  font-size: 30px;
  letter-spacing: -1.5px;
  margin: 5px 0;
}

.heading p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
}

.local-note {
  font-size: 12px;
  color: var(--muted);
}

.workspace {
  display: grid;
  grid-template-columns: 286px minmax(300px, 1fr) 258px;
  gap: 24px;
  align-items: start;
}

.panel {
  background: white;
  border: 1px solid var(--line);
  border-radius: 13px;
  padding: 20px;
}

.panel-title {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}

.panel-title > span {
  color: #aaa89d;
  font: 12px monospace;
}

h2 {
  font-size: 17px;
  margin: 0;
}

label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  margin: 10px 0 7px;
}

.upload {
  border: 1px dashed #c7c3b5;
  background: #faf9f4;
  border-radius: 9px;
  text-align: center;
  padding: 16px 8px;
  cursor: pointer;
}

.upload strong {
  display: block;
  font-size: 14px;
}

.upload small {
  font-size: 12px;
  color: var(--muted);
  font-weight: 400;
}

.image-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 10px 0 20px;
}

.image-actions button {
  padding: 5px 7px;
  font-size: 12px;
}

.image-actions label {
  font-size: 12px;
  margin: 0 0 0 auto;
  white-space: nowrap;
}

.image-actions select {
  font-size: 12px;
  width: auto;
  padding: 5px;
}

select,
input[type="text"],
input:not([type]),
textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 7px;
  padding: 10px;
  background: #fff;
  color: var(--ink);
}

.text-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #f2f1eb;
  border-radius: 8px;
  padding: 4px;
}

.text-tabs button {
  border: 0;
  background: none;
  padding: 6px;
  font-size: 14px;
}

.text-tabs button.active {
  background: white;
  box-shadow: 0 1px 4px #0001;
  font-weight: bold;
}

textarea {
  resize: vertical;
  min-height: 90px;
  font-size: 15px;
}

.caption-meta {
  display: flex;
  justify-content: space-between;
  font-size: 11px;
  color: var(--muted);
  margin-bottom: 15px;
}

.slider-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slider-heading label {
  margin: 7px 0;
}

.slider-heading output {
  font: 12px monospace;
  color: var(--muted);
}

input[type="range"] {
  width: 100%;
  accent-color: #373a31;
  height: 15px;
  margin: 0 0 7px;
}

.color-row {
  display: flex;
  gap: 22px;
  border-top: 1px solid var(--line);
  margin-top: 12px;
  padding-top: 4px;
}

.color-row label {
  display: flex;
  gap: 12px;
  align-items: center;
  font-size: 13px;
}

input[type="color"] {
  width: 28px;
  height: 28px;
  padding: 1px;
  border: 1px solid var(--line);
  background: none;
  border-radius: 6px;
  cursor: pointer;
}

.check {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  font-weight: 400;
}

.check input {
  accent-color: #373a31;
}

.fine {
  font-size: 12px;
  color: var(--muted);
  margin: 7px 0 0;
}

.preview-panel {
  min-width: 0;
}

.preview-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 4px 12px;
}

.preview-top > span:last-child {
  font: 12px monospace;
  color: var(--muted);
}

.canvas-stage {
  height: 480px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 22px;
  background-color: #eae8df;
  background-image: radial-gradient(
    #c9c6bb 0.8px,
    transparent 0.8px
  );
  background-size: 12px 12px;
}

canvas {
  display: block;
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
  box-shadow: 0 8px 30px #0002;
}

.ratio-tabs {
  display: flex;
  justify-content: center;
  gap: 10px;
  padding: 17px 0 0;
}

.ratio-tabs button {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  background: transparent;
}

.ratio-tabs button.active {
  background: #fff8d9;
  border-color: #d1b34b;
}

.ratio-tabs small {
  color: var(--muted);
  font-size: 12px;
}

.ratio-tabs i {
  border: 1.5px solid currentColor;
  display: inline-block;
  width: 14px;
  height: 14px;
  border-radius: 2px;
}

.ratio-tabs .r-portrait {
  height: 17px;
}

.ratio-tabs .r-story {
  height: 20px;
  width: 11px;
}

#notice {
  font-size: 13px;
  text-align: center;
  margin: 12px 0 0;
  color: #515747;
}

#notice.error {
  color: #a53528;
}

#fitNotice {
  text-align: center;
}

.muted {
  color: var(--muted);
  font-size: 13px;
}

.inspiration > .muted {
  margin: 0 0 16px;
}

.preset {
  display: block;
  width: 100%;
  text-align: left;
  padding: 14px;
  border-radius: 10px;
  margin-bottom: 12px;
  background: #faf9f4;
}

.preset:nth-of-type(2) {
  background: #f2f4ee;
}

.preset:nth-of-type(3) {
  background: #f3f2f7;
}

.preset span {
  font-size: 12px;
  color: var(--muted);
}

