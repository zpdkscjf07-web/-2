(function (root) {
  "use strict";

  const RATIOS = {
    "1:1": [1080, 1080],
    "4:5": [1080, 1350],
    "9:16": [1080, 1920]
  };

  const presets = [
    "오류 30개 잡고\n드디어 실행됐을 때",
    "퇴근 1분 전\n추가 업무가 없을 때",
    "미루던 일\n드디어 끝냈을 때"
  ];

  const clone = (value) => {
    return JSON.parse(JSON.stringify(value));
  };

  function initial() {
    return {
      ratio: "1:1",
      fit: "contain",
      bg: "#f6eccc",
      outline: true,
      image: "builtin:muyaho",

      origin:
        "사용자 제공 무한도전 방송 캡처 · 원본 URL 미제공",

      license: "사용 허가 근거 미확인",

      top: {
        text: presets[0],
        size: 64,
        color: "#ffffff",
        x: 50,
        y: 5
      },

      bottom: {
        text: "",
        size: 72,
        color: "#ffffff",
        x: 50,
        y: 76
      }
    };
  }

  const plain = (value) => {
    return (
      value !== null &&
      typeof value === "object" &&
      !Array.isArray(value)
    );
  };

  const finite = (value, min, max) => {
    return (
      typeof value === "number" &&
      Number.isFinite(value) &&
      value >= min &&
      value <= max
    );
  };

  function validateModel(model) {
    if (
      !plain(model) ||
      !Object.hasOwn(RATIOS, model.ratio) ||
      !["cover", "contain"].includes(model.fit) ||
      !/^#[0-9a-f]{6}$/i.test(model.bg) ||
      typeof model.outline !== "boolean" ||
      typeof model.image !== "string" ||
      model.image.length > 5500000 ||
      !(
        model.image === "builtin:muyaho" ||
        /^data:image\/(png|jpeg);base64,[A-Za-z0-9+/]+={0,2}$/.test(
          model.image
        )
      ) ||
      typeof model.origin !== "string" ||
      model.origin.length > 500 ||
      typeof model.license !== "string" ||
      model.license.length > 300
    ) {
      throw Error(
        "필수 항목 또는 이미지·배경 설정이 올바르지 않습니다."
      );
    }

    for (const key of ["top", "bottom"]) {
      const text = model[key];

      if (
        !plain(text) ||
        typeof text.text !== "string" ||
        text.text.length > 2000 ||
        !finite(text.size, 20, 160) ||
        !finite(text.x, 15, 85) ||
        !finite(text.y, 0, 85) ||
        !/^#[0-9a-f]{6}$/i.test(text.color)
      ) {
        throw Error(
          "문구·크기·위치·색 설정이 올바르지 않습니다."
        );
      }
    }

    return {
      ratio: model.ratio,
      fit: model.fit,
      bg: model.bg,
      outline: model.outline,
      image: model.image,
      origin: model.origin,
      license: model.license,
      top: { ...model.top },
      bottom: { ...model.bottom }
    };
  }

  function parseBackup(raw) {
    let data;

    try {
      data = JSON.parse(raw);
    } catch {
      throw Error(
        "JSON 문법이 손상되었습니다. 기존 템플릿은 유지됩니다."
      );
    }

    if (
      !plain(data) ||
      data.version !== 1 ||
      !Array.isArray(data.templates) ||
      data.templates.length > 20
    ) {
      throw Error(
        "version: 1과 templates 배열(최대 20개)이 필요합니다."
      );
    }

    const ids = new Set();

    return data.templates.map((template) => {
      if (
        !plain(template) ||
        typeof template.id !== "string" ||
        !template.id ||
        template.id.length > 100 ||
        ids.has(template.id) ||
        typeof template.name !== "string" ||
        !template.name.trim() ||
        template.name.length > 60
      ) {
        throw Error(
          "템플릿 ID 또는 이름이 올바르지 않습니다."
        );
      }

      ids.add(template.id);

      return {
        id: template.id,
        name: template.name,
        model: validateModel(template.model)
      };
    });
  }

  const segmenter =
    typeof Intl.Segmenter === "function"
      ? new Intl.Segmenter("ko", {
          granularity: "grapheme"
        })
      : null;

  function graphemes(text) {
    if (segmenter) {
      return Array.from(
        segmenter.segment(text),
        (value) => value.segment
      );
    }

    return Array.from(text);
  }

  function wrapText(context, text, width) {
    const lines = [];

    for (const paragraph of text.split("\n")) {
      let line = "";

      for (const character of graphemes(paragraph)) {
        if (
          line &&
          context.measureText(line + character).width > width
        ) {
          lines.push(line);
          line = character;
        } else {
          line += character;
        }
      }

      lines.push(line);
    }

    return lines;
  }

  function render(canvas, model, image) {
    validateModel(model);

    const [width, height] = RATIOS[model.ratio];

    if (canvas.width !== width) {
      canvas.width = width;
    }

    if (canvas.height !== height) {
      canvas.height = height;
    }

    const context = canvas.getContext("2d");

    context.clearRect(0, 0, width, height);
    context.fillStyle = model.bg;
    context.fillRect(0, 0, width, height);

    const imageWidth = image.naturalWidth || image.width;
    const imageHeight = image.naturalHeight || image.height;

    const scale =
      model.fit === "cover"
        ? Math.max(
            width / imageWidth,
            height / imageHeight
          )
        : Math.min(
            width / imageWidth,
            height / imageHeight
          );

    context.drawImage(
      image,
      (width - imageWidth * scale) / 2,
      (height - imageHeight * scale) / 2,
      imageWidth * scale,
      imageHeight * scale
    );

    const layouts = [];

    for (const key of ["top", "bottom"]) {
      const text = model[key];

      if (!text.text) {
        layouts.push({
          key,
          lines: [],
          size: text.size
        });

        continue;
      }

      const x = (width * text.x) / 100;
      const top = (height * text.y) / 100 + 8;

      const availableWidth = Math.max(
        80,
        2 * Math.min(x, width - x) - 48
      );

      const availableHeight = Math.max(
        20,
        Math.min(
          height * 0.36,
          height - top - 16
        )
      );

      let size = text.size;
      let lines = [];

      for (; size >= 2; size--) {
        context.font =
          `900 ${size}px "Meme Sans", ` +
          `"Malgun Gothic", Arial, sans-serif`;

        lines = wrapText(
          context,
          text.text,
          availableWidth
        );

        const fitsHeight =
          lines.length * size * 1.3 <= availableHeight;

        const fitsWidth = lines.every((line) => {
          return (
            context.measureText(line).width <= availableWidth
          );
        });

        if (fitsHeight && fitsWidth) {
          break;
        }
      }

      size = Math.max(2, size);

      if (
        lines.length * size * 1.3 > availableHeight
      ) {
        size =
          availableHeight / (lines.length * 1.3);
      }

      context.font =
        `900 ${size}px "Meme Sans", ` +
        `"Malgun Gothic", Arial, sans-serif`;

      context.textAlign = "center";
      context.textBaseline = "middle";
      context.lineJoin = "round";
      context.strokeStyle = "#161616";
      context.lineWidth = Math.max(1, size * 0.085);
      context.fillStyle = text.color;

      lines.forEach((line, index) => {
        const y =
          top +
          size * 0.8 +
          index * size * 1.3;

        if (model.outline) {
          context.strokeText(line, x, y);
        }

        context.fillText(line, x, y);
      });

      layouts.push({
        key,
        size,
        lines,
        x,
        top,
        width: availableWidth,
        height: availableHeight
      });
    }

    return layouts;
  }

  const api = {
    RATIOS,
    presets,
    clone,
    initial,
    validateModel,
    parseBackup,
    wrapText,
    render
  };

  root.MemeCore = api;

  if (typeof module !== "undefined") {
    module.exports = api;
  }
})(typeof globalThis !== "undefined" ? globalThis : this);

