"use strict";

(async () => {
  const $ = (id) => document.getElementById(id);
  const C = MemeCore;
  const KEY = "muyaho.templates.v1";

  let model = C.initial();
  let layer = "top";
  let selected = null;
  let templates = [];
  let image = null;
  let loading = 0;
  let request = 0;
  let ready = false;

  const canvas = $("canvas");

  function notice(text, error = false) {
    $("notice").textContent = text;
    $("notice").classList.toggle("error", error);
  }

  function buttons() {
    for (const id of [
      "download",
      "saveNew",
      "exportJson",
      "importJson"
    ]) {
      $(id).disabled = !ready || loading > 0;
    }

    document
      .querySelectorAll("#templateList button")
      .forEach((button) => {
        button.disabled = loading > 0;
      });
  }

  function uuid() {
    if (typeof crypto.randomUUID === "function") {
      return crypto.randomUUID();
    }

    return (
      Date.now().toString(36) +
      "-" +
      Math.random().toString(36).slice(2)
    );
  }

  function loadImage(source) {
    return new Promise((resolve, reject) => {
      const img = new Image();

      img.onload = () => resolve(img);

      img.onerror = () => {
        reject(
          Error(
            "이미지를 해석할 수 없습니다. 기존 작업은 유지됩니다."
          )
        );
      };

      img.src =
        source === "builtin:muyaho"
          ? "muyaho.png"
          : source;
    });
  }

  function normalized(img) {
    const width = img.naturalWidth;
    const height = img.naturalHeight;

    if (
      !width ||
      !height ||
      width * height > 40000000
    ) {
      throw Error(
        "이미지는 4천만 화소 이하여야 합니다."
      );
    }

    const scale = Math.min(
      1,
      1600 / Math.max(width, height)
    );

    const temp = document.createElement("canvas");

    temp.width = Math.round(width * scale);
    temp.height = Math.round(height * scale);

    temp.getContext("2d").drawImage(
      img,
      0,
      0,
      temp.width,
      temp.height
    );

    const url = temp.toDataURL("image/png");

    if (url.length > 5500000) {
      throw Error(
        "이미지 데이터가 너무 큽니다. 더 작은 이미지를 사용하세요."
      );
    }

    return url;
  }

  async function normalizeSource(source) {
    const img = await loadImage(source);

    if (source === "builtin:muyaho") {
      return {
        src: source,
        im: img
      };
    }

    const clean = normalized(img);

    return {
      src: clean,
      im: await loadImage(clean)
    };
  }

  function paint() {
    if (!image) {
      return;
    }

    const layouts = C.render(canvas, model, image);
    const [width, height] = C.RATIOS[model.ratio];

    $("dimensions").textContent =
      `${width} × ${height}`;

    const reduced = layouts.some((layout) => {
      return layout.size < model[layout.key].size;
    });

    $("fitNotice").textContent = reduced
      ? "긴 문구를 영역에 맞게 자동 축소했어요."
      : "미리보기 그대로, 같은 해상도의 PNG로 저장됩니다.";
  }

  function sync() {
    const text = model[layer];

    $("caption").value = text.text;
    $("chars").textContent =
      `${text.text.length} / 2000`;

    $("fontSize").value = text.size;
    $("textX").value = text.x;
    $("textY").value = text.y;

    $("sizeValue").textContent = text.size + "px";
    $("xValue").textContent = text.x + "%";
    $("yValue").textContent = text.y + "%";

    $("textColor").value = text.color;
    $("bgColor").value = model.bg;
    $("fit").value = model.fit;
    $("outline").checked = model.outline;
    $("origin").value = model.origin;
    $("license").value = model.license;

    document
      .querySelectorAll("[data-layer]")
      .forEach((button) => {
        const active =
          button.dataset.layer === layer;

        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", active);
      });

    document
      .querySelectorAll("[data-ratio]")
      .forEach((button) => {
        const active =
          button.dataset.ratio === model.ratio;

        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", active);
      });

    paint();
  }

  function commit(next) {
    if (next.length > 20) {
      throw Error(
        "템플릿은 최대 20개까지 저장할 수 있습니다. JSON으로 백업한 뒤 정리하세요."
      );
    }

    const json = JSON.stringify({
      version: 1,
      templates: next
    });

    C.parseBackup(json);

    try {
      localStorage.setItem(KEY, json);
    } catch {
      throw Error(
        "브라우저 저장 공간이 부족하거나 차단되었습니다. 기존 목록은 유지됩니다. JSON 백업을 사용하세요."
      );
    }

    templates = next;
    renderTemplates();
  }

  function openTemplates() {
    $("templateSection").hidden = false;

    $("templateSection").scrollIntoView({
      behavior: "smooth"
    });
  }

  function renderTemplates() {
    $("count").textContent = templates.length;
    $("templateList").replaceChildren();

    if (!templates.length) {
      const paragraph = document.createElement("p");

      paragraph.className = "empty";

      paragraph.textContent =
        "아직 저장한 템플릿이 없어요. 마음에 드는 조합을 저장해 보세요.";

      $("templateList").append(paragraph);
    }

    for (const template of templates) {
      const card = document.createElement("article");

      card.className =
        "template-card" +
        (selected === template.id ? " selected" : "");

      const name = document.createElement("h3");
      name.textContent = template.name;

      const paragraph = document.createElement("p");

      paragraph.textContent =
        template.model.ratio +
        " · " +
        (
          template.model.top.text ||
          template.model.bottom.text ||
          "문구 없음"
        );

      const actions = document.createElement("div");
      actions.className = "actions";

      const commands = [
        [
          "불러오기",
          () => useTemplate(template.id)
        ],
        [
          "수정 저장",
          () => updateTemplate(template.id)
        ],
        [
          "삭제",
          () => deleteTemplate(template.id)
        ]
      ];

      for (const [label, action] of commands) {
        const button = document.createElement("button");

        button.textContent = label;
        button.onclick = action;

        actions.append(button);
      }

      card.append(name, paragraph, actions);
      $("templateList").append(card);
    }

    buttons();
  }

  async function useTemplate(id) {
    const template = templates.find((item) => {
      return item.id === id;
    });

    if (!template) {
      return;
    }

    const token = ++request;

    loading++;
    buttons();

    try {
      const next = C.clone(template.model);
      const result = await normalizeSource(next.image);

      if (token !== request) {
        return;
      }

      next.image = result.src;

      image = result.im;
      model = next;
      selected = id;

      $("templateName").value = template.name;

      sync();
      renderTemplates();

      notice("템플릿을 불러왔어요.");
    } catch (error) {
      notice(error.message, true);
    } finally {
      loading--;
      buttons();
    }
  }

  function updateTemplate(id) {
    if (!ready || loading) {
      return;
    }

    if (selected !== id) {
      notice(
        "수정할 템플릿을 먼저 불러온 뒤 편집하세요.",
        true
      );

      return;
    }

    const name = $("templateName").value.trim();

    if (!name) {
      notice("템플릿 이름을 입력하세요.", true);
      return;
    }

    try {
      commit(
        templates.map((template) => {
          if (template.id === id) {
            return {
              id,
              name,
              model: C.clone(model)
            };
          }

          return template;
        })
      );

      notice(
        "같은 템플릿에 수정 사항을 저장했어요."
      );
    } catch (error) {
      notice(error.message, true);
    }
  }

  function deleteTemplate(id) {
    const template = templates.find((item) => {
      return item.id === id;
    });

    if (
      !template ||
      !confirm(
        "“" + template.name + "” 템플릿을 삭제할까요?"
      )
    ) {
      return;
    }

    try {
      const next = templates.filter((item) => {
        return item.id !== id;
      });

      commit(next);

      if (selected === id) {
        selected = null;
        renderTemplates();
      }

      notice(
        "템플릿을 삭제했어요. 현재 편집 내용은 유지됩니다."
      );
    } catch (error) {
      notice(error.message, true);
    }
  }

  $("saveNew").onclick = () => {
    const name = $("templateName").value.trim();

    if (!name) {
      notice(
        "템플릿 이름을 먼저 입력하세요.",
        true
      );

      $("templateName").focus();
      return;
    }

    try {
      const id = uuid();

      commit([
        ...templates,
        {
          id,
          name,
          model: C.clone(model)
        }
      ]);

      selected = id;

      renderTemplates();
      openTemplates();

      notice(
        "사진과 문구를 새 템플릿으로 저장했어요."
      );
    } catch (error) {
      notice(error.message, true);
    }
  };

  $("templatesTab").onclick = openTemplates;

  document
    .querySelectorAll("[data-layer]")
    .forEach((button) => {
      button.onclick = () => {
        layer = button.dataset.layer;
        sync();
      };
    });

  document
    .querySelectorAll("[data-ratio]")
    .forEach((button) => {
      button.onclick = () => {
        model.ratio = button.dataset.ratio;
        sync();
      };
    });

  const textFields = [
    ["caption", "text"],
    ["fontSize", "size"],
    ["textX", "x"],
    ["textY", "y"],
    ["textColor", "color"]
  ];

  for (const [id, key] of textFields) {
    $(id).addEventListener("input", () => {
      model[layer][key] =
        ["size", "x", "y"].includes(key)
          ? Number($(id).value)
          : $(id).value;

      const text = model[layer];

      $("chars").textContent =
        text.text.length + " / 2000";

      $("sizeValue").textContent =
        text.size + "px";

      $("xValue").textContent =
        text.x + "%";

      $("yValue").textContent =
        text.y + "%";

      paint();
    });
  }

  const modelFields = [
    ["bgColor", "bg"],
    ["fit", "fit"],
    ["origin", "origin"],
    ["license", "license"]
  ];

  for (const [id, key] of modelFields) {
    $(id).addEventListener("input", () => {
      model[key] = $(id).value;
      paint();
    });
  }

  $("outline").onchange = () => {
    model.outline = $("outline").checked;
    paint();
  };

  document
    .querySelectorAll("[data-preset]")
    .forEach((button) => {
      button.onclick = () => {
        model.top.text =
          C.presets[Number(button.dataset.preset)];

        layer = "top";

        sync();

        notice(
          "문구를 적용했어요. 크기와 위치를 조절해 보세요."
        );
      };
    });

  async function replaceImage(source, isDefault) {
    const token = ++request;

    loading++;
    buttons();

    try {
      const result = await normalizeSource(source);

      if (token !== request) {
        return;
      }

      model.image = result.src;
      image = result.im;

      if (isDefault) {
        model.origin = C.initial().origin;
        model.license = C.initial().license;
      } else {
        model.origin = "";
        model.license = "";
      }

      sync();

      notice(
        "이미지를 불러왔어요. 출처 기록도 확인해 주세요."
      );
    } catch (error) {
      notice(error.message, true);
    } finally {
      loading--;
      buttons();
    }
  }

  $("defaultImage").onclick = () => {
    return replaceImage("builtin:muyaho", true);
  };

  $("imageFile").onchange = async () => {
    const file = $("imageFile").files[0];

    $("imageFile").value = "";

    if (!file) {
      return;
    }

    try {
      if (file.size > 10 * 1024 * 1024) {
        throw Error(
          "이미지 파일은 10MB 이하여야 합니다. 기존 작업은 유지됩니다."
        );
      }

      const header = new Uint8Array(
        await file.slice(0, 12).arrayBuffer()
      );

      const png =
        header[0] === 137 &&
        header[1] === 80 &&
        header[2] === 78 &&
        header[3] === 71 &&
        header[4] === 13 &&
        header[5] === 10 &&
        header[6] === 26 &&
        header[7] === 10;

      const jpeg =
        header[0] === 255 &&
        header[1] === 216 &&
        header[2] === 255;

      if (!png && !jpeg) {
        throw Error(
          "PNG와 JPEG만 지원합니다. 파일 내용이 지원 형식이 아닙니다. 기존 작업은 유지됩니다."
        );
      }

      const url = URL.createObjectURL(file);

      try {
        await replaceImage(url, false);
      } finally {
        URL.revokeObjectURL(url);
      }
    } catch (error) {
      notice(error.message, true);
    }
  };

  function downloadBlob(blob, name) {
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");

    anchor.href = url;
    anchor.download = name;

    document.body.append(anchor);
    anchor.click();
    anchor.remove();

    setTimeout(() => {
      URL.revokeObjectURL(url);
    }, 1500);
  }

  $("download").onclick = async () => {
    loading++;
    buttons();

    try {
      await document.fonts.load(
        '900 64px "Meme Sans"'
      );

      await document.fonts.ready;

      paint();

      const blob = await new Promise(
        (resolve, reject) => {
          canvas.toBlob((result) => {
            if (result) {
              resolve(result);
            } else {
              reject(
                Error("PNG 생성에 실패했습니다.")
              );
            }
          }, "image/png");
        }
      );

      downloadBlob(
        blob,
        "muyaho-" +
          model.ratio.replace(":", "x") +
          ".png"
      );

      notice(
        "PNG를 저장했어요. 다운로드 폴더에서 확인하세요."
      );
    } catch (error) {
      notice(error.message, true);
    } finally {
      loading--;
      buttons();
    }
  };

  $("exportJson").onclick = async () => {
    if (!templates.length) {
      notice(
        "저장할 템플릿을 먼저 만들어 주세요.",
        true
      );

      return;
    }

    loading++;
    buttons();

    try {
      const exported = C.clone(templates);
      let builtin;

      for (const template of exported) {
        if (
          template.model.image === "builtin:muyaho"
        ) {
          if (!builtin) {
            builtin = normalized(
              await loadImage("builtin:muyaho")
            );
          }

          template.model.image = builtin;
        }
      }

      const text = JSON.stringify(
        {
          version: 1,
          templates: exported
        },
        null,
        2
      );

      if (text.length > 16 * 1024 * 1024) {
        throw Error(
          "백업이 너무 큽니다. 이미지 크기나 템플릿 수를 줄여 주세요."
        );
      }

      downloadBlob(
        new Blob([text], {
          type: "application/json"
        }),
        "muyaho-templates.json"
      );

      notice(
        "사진이 포함된 JSON 백업을 저장했어요."
      );
    } catch (error) {
      notice(error.message, true);
    } finally {
      loading--;
      buttons();
    }
  };

  $("importJson").onclick = () => {
    $("jsonFile").click();
  };

  $("jsonFile").onchange = async () => {
    const file = $("jsonFile").files[0];

    $("jsonFile").value = "";

    if (!file) {
      return;
    }

    loading++;
    buttons();

    try {
      if (file.size > 16 * 1024 * 1024) {
        throw Error("JSON은 16MB 이하여야 합니다.");
      }

      const imported = C.parseBackup(
        await file.text()
      );

      if (
        templates.length + imported.length > 20
      ) {
        throw Error(
          "가져온 뒤 템플릿 수가 20개를 넘습니다. 기존 목록은 유지됩니다."
        );
      }

      const clean = [];

      for (const template of imported) {
        const result = await normalizeSource(
          template.model.image
        );

        clean.push({
          id: uuid(),
          name: template.name,

          model: {
            ...template.model,
            image: result.src
          }
        });
      }

      commit([
        ...templates,
        ...clean
      ]);

      openTemplates();

      notice(
        clean.length +
          "개 템플릿을 추가로 복원했어요."
      );
    } catch (error) {
      notice(error.message, true);
    } finally {
      loading--;
      buttons();
    }
  };

  buttons();

  try {
    const raw = localStorage.getItem(KEY);

    if (raw) {
      templates = C.parseBackup(raw);
    }
  } catch (error) {
    notice(
      "저장된 템플릿을 읽지 못했습니다. 원본 저장은 덮어쓰지 않았어요.",
      true
    );
  }

  renderTemplates();

  try {
    await document.fonts.load(
      '900 64px "Meme Sans"'
    );

    await document.fonts.ready;

    image = await loadImage("builtin:muyaho");
    ready = true;

    sync();

    notice(
      "위 문구를 바꿔서 나만의 무야호를 만들어 보세요."
    );
  } catch (error) {
    notice(error.message, true);
  } finally {
    buttons();
  }

  if (document.modelContext?.registerTool) {
    try {
      Promise.resolve(
        document.modelContext.registerTool({
          name: "read_meme_editor",

          description:
            "Read current meme captions, aspect ratio and template count.",

          inputSchema: {
            type: "object",
            properties: {},
            additionalProperties: false
          },

          annotations: {
            readOnlyHint: true
          },

          execute: (input) => {
            if (
              !input ||
              typeof input !== "object" ||
              Array.isArray(input) ||
              Object.keys(input).length
            ) {
              throw Error("Expected empty object");
            }

            return {
              ratio: model.ratio,
              top: model.top.text,
              bottom: model.bottom.text,
              templates: templates.length,
              ready
            };
          }
        })
      ).catch(() => {});
    } catch {}
  }
})();
