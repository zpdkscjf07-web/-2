              <th>설정</th>
              <th>점수</th>
              <th>시간</th>
              <th>적중</th>
              <th>결과</th>
              <th>실패 원인</th>
            </tr>
          </thead>

          <tbody id="rows"></tbody>
        </table>
      </div>

      <label for="choice">내 최종 선택</label>

      <select id="choice">
        <option value="">아직 선택하지 않음</option>
        <option value="A">A</option>
        <option value="B">B</option>
      </select>

      <label for="reason">
        선택 이유 (개인정보를 적지 마세요)
      </label>

      <textarea
