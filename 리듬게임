"use strict";

(() => {
  const $ = (id) => document.getElementById(id);

  const STORAGE_KEY = "pulse30.v1";
  const TOTAL_NOTES = 56;
  const GAME_DURATION = 30;
  const REQUIRED_HITS = 40;

  const KEY_CODES = ["KeyD", "KeyF", "KeyJ", "KeyK"];
  const pads = [...document.querySelectorAll(".pads button")];

  function defaults() {
    return {
      version: 1,
      best: 0,
      records: [],
      mode: "A",
      sound: true,
      reduce: window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches,
      choice: "",
      reason: ""
    };
  }

  function validRecord(record) {
    return (
      record &&
      ["A", "B"].includes(record.mode) &&
      Number.isInteger(record.score) &&
      record.score >= 0 &&
      record.score <= 56000 &&
      Number.isInteger(record.hits) &&
      record.hits >= 0 &&
      record.hits <= TOTAL_NOTES &&
      record.time === GAME_DURATION &&
      record.success === (record.hits >= REQUIRED_HITS) &&
      ["노트 놓침", "없음"].includes(record.cause)
    );
  }

  function decode(raw) {
    if (!raw) {
      return defaults();
    }

    const parsed = JSON.parse(raw);

    const valid =
      parsed &&
      parsed.version === 1 &&
      Number.isInteger(parsed.best) &&
      parsed.best >= 0 &&
      parsed.best <= 56000 &&
      Array.isArray(parsed.records) &&
      parsed.records.length <= 200 &&
      parsed.records.every(validRecord) &&
      ["A", "B"].includes(parsed.mode) &&
      typeof parsed.sound === "boolean" &&
      typeof parsed.reduce === "boolean" &&
      ["", "A", "B"].includes(parsed.choice) &&
      typeof parsed.reason === "string" &&
      parsed.reason.length <= 2000;

    if (!valid) {
      throw new Error("손상된 저장");
    }

    return parsed;
  }

  let data;

  try {
    data = decode(localStorage.getItem(STORAGE_KEY));
  } catch {
    data = defaults();

    $("storageStatus").textContent =
      "저장값을 읽을 수 없어 기본값으로 복구했습니다.";

    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    } catch {
      // 저장 불가 환경에서도 메모리에서 게임을 계속 실행합니다.
    }
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
      return true;
    } catch {
      $("storageStatus").textContent =
        "저장 공간을 사용할 수 없습니다. 이번 방문 동안만 기록됩니다.";

      return false;
    }
  }

  let state = "ready";
  let time = 0;
  let lastTime = 0;
  let score = 0;
  let combo = 0;
  let hits = 0;
  let misses = 0;
  let inputs = 0;
  let chart = [];
  let mode = "A";
  let beatIndex = -1;
  let judgeUntil = 0;

  let audio = null;
  let master = null;

  const voices = new Set();
  const flashTimers = new Map();

  function makeChart() {
    const pattern = [
      0, 1, 2, 3,
      1, 2, 0, 3,
      2, 1, 3, 0,
      1, 3, 2, 0
    ];

    return Array.from({ length: TOTAL_NOTES }, (_, index) => ({
      time: 2 + index * 0.5,
      lane: pattern[index % pattern.length],
      done: false,
      element: null
    }));
  }

  function audioInit() {
    try {
      if (!audio) {
        const AudioContextClass =
          window.AudioContext || window.webkitAudioContext;

        if (!AudioContextClass) {
          throw new Error("오디오 미지원");
        }

        audio = new AudioContextClass();
        master = audio.createGain();
        master.connect(audio.destination);
      }

      master.gain.value = data.sound ? 0.22 : 0;

      audio.resume().catch(() => {
        $("storageStatus").textContent =
          "오디오 재생이 차단되었습니다. 사운드를 다시 켜 보세요.";
      });
    } catch {
      $("storageStatus").textContent =
        "오디오를 사용할 수 없습니다. 화면으로 플레이할 수 있습니다.";
    }
  }

  function tone(
    frequency,
    duration,
    type = "sine",
    delay = 0
  ) {
    if (
      !audio ||
      !master ||
      !data.sound ||
      audio.state !== "running"
    ) {
      return;
    }

    const oscillator = audio.createOscillator();
    const gain = audio.createGain();
    const startAt = audio.currentTime + delay;

    oscillator.type = type;
    oscillator.frequency.setValueAtTime(frequency, startAt);

    gain.gain.setValueAtTime(0, startAt);
    gain.gain.linearRampToValueAtTime(0.4, startAt + 0.008);
    gain.gain.exponentialRampToValueAtTime(
      0.001,
      startAt + duration
    );

    oscillator.connect(gain);
    gain.connect(master);

    oscillator.start(startAt);
    oscillator.stop(startAt + duration + 0.01);

    voices.add(oscillator);

    oscillator.onended = () => {
      voices.delete(oscillator);
      oscillator.disconnect();
      gain.disconnect();
    };
  }

  function stopAudio() {
    for (const oscillator of voices) {
      try {
        oscillator.stop();
      } catch {
        // 이미 끝난 음은 그대로 둡니다.
      }
    }

    voices.clear();
  }

  function music() {
    const targetBeat = Math.floor((time + 0.05) * 4);

    while (beatIndex < targetBeat) {
      beatIndex += 1;

      const beatTime = beatIndex / 4;

      if (
        beatTime < time - 0.08 ||
        beatTime >= GAME_DURATION
      ) {
        continue;
      }

      const delay = Math.max(0, beatTime - time);

      if (beatIndex % 2 === 0) {
        tone(
          beatIndex % 8 === 0 ? 65 : 90,
          0.13,
          "sine",
          delay
        );

        const melody = [220, 261.63, 329.63, 293.66];
        const melodyIndex = Math.floor(beatIndex / 8) % 4;

        tone(
          melody[melodyIndex],
          0.14,
          "triangle",
          delay
        );
      } else {
        tone(1800, 0.025, "square", delay);
      }
    }
  }

  function clearFlashes() {
    for (const timer of flashTimers.values()) {
      clearTimeout(timer);
    }

    flashTimers.clear();

    for (const pad of pads) {
      pad.classList.remove("active");
    }
  }

  function flashPad(lane) {
    if (data.reduce) {
      return;
    }

    const pad = pads[lane];

    if (flashTimers.has(lane)) {
      clearTimeout(flashTimers.get(lane));
    }

    pad.classList.add("active");

    const timer = setTimeout(() => {
      pad.classList.remove("active");
      flashTimers.delete(lane);
    }, 90);

    flashTimers.set(lane, timer);
  }

  function applySettings() {
    $("mode").value = data.mode;
    $("sound").checked = data.sound;
    $("reduce").checked = data.reduce;

    document.body.classList.toggle("reduced", data.reduce);

    if (master) {
      master.gain.value = data.sound ? 0.22 : 0;
    }

    $("best").textContent = String(data.best).padStart(5, "0");
  }

  function metrics() {
    $("score").textContent = String(score).padStart(5, "0");
    $("combo").textContent = `${combo}×`;

    $("time").textContent = Math.max(
      0,
      GAME_DURATION - time
    ).toFixed(1);

    $("hitcount").textContent = `${hits} / ${TOTAL_NOTES} HIT`;

    $("progress").style.width =
      `${(time / GAME_DURATION) * 100}%`;
  }

  function setState(nextState) {
    state = nextState;

    const labels = {
      ready: "READY",
      playing: "PLAYING",
      paused: "PAUSED",
      success: "CLEAR",
      failed: "FAILED"
    };

    $("state").textContent = labels[nextState];

    $("pause").disabled =
      !["playing", "paused"].includes(nextState);

    $("pause").textContent =
      nextState === "paused" ? "재개 ▶" : "일시정지 Ⅱ";

    $("mode").disabled =
      ["playing", "paused"].includes(nextState);
  }

  function announce(word) {
    $("judge").textContent = word;
    judgeUntil = time + 0.45;
  }

  function resetRound() {
    stopAudio();
    clearFlashes();

    time = 0;
    lastTime = 0;
    score = 0;
    combo = 0;
    hits = 0;
    misses = 0;
    inputs = 0;
    beatIndex = -1;
    judgeUntil = 0;
    chart = [];

    $("notes").replaceChildren();
    $("judge").textContent = "";

    metrics();
  }

  function start() {
    resetRound();
    audioInit();

    mode = data.mode;
    chart = makeChart();

    for (const note of chart) {
      const element = document.createElement("div");

      element.className =
        "note" + ([0, 3].includes(note.lane) ? " outer" : "");

      element.style.setProperty("--lane", note.lane);
      element.hidden = true;

      $("notes").append(element);
      note.element = element;
    }

    $("overlay").hidden = true;

    setState("playing");
    lastTime = performance.now();

    draw();
  }

  function trimRecords() {
    if (data.records.length <= 200) {
      return;
    }

    // 각 설정의 첫 10회는 비교용으로 보존합니다.
    const counts = { A: 0, B: 0 };

    const removableIndex = data.records.findIndex((record) => {
      counts[record.mode] += 1;
      return counts[record.mode] > 10;
    });

    if (removableIndex >= 0) {
      data.records.splice(removableIndex, 1);
    }
  }

  function end() {
    const success = hits >= REQUIRED_HITS;

    setState(success ? "success" : "failed");
    stopAudio();
    clearFlashes();

    data.records.push({
      mode,
      score,
      hits,
      time: GAME_DURATION,
      success,
      cause: success ? "없음" : "노트 놓침"
    });

    trimRecords();

    data.best = Math.max(data.best, score);

    save();
    applySettings();
    renderRecords();

    $("overlayTitle").textContent = success
      ? "리듬을 완성했어요!"
      : "다시 비트를 잡아볼까요?";

    $("overlayText").textContent =
      `${hits} / ${TOTAL_NOTES} 적중 · ` +
      `${score.toLocaleString()}점 · 목표 ${REQUIRED_HITS}개`;

    $("start").textContent = "다시 플레이 ↻";
    $("overlay").hidden = false;
  }

  function advance(now) {
    if (state !== "playing") {
      return;
    }

    const delta = Math.max(0, (now - lastTime) / 1000);
    lastTime = now;

    time = Math.min(GAME_DURATION, time + delta);

    const tolerance = mode === "A" ? 0.1 : 0.15;

    for (const note of chart) {
      if (!note.done && time > note.time + tolerance) {
        note.done = true;
        misses += 1;
        combo = 0;
        announce("MISS");
      }
    }

    if (time >= GAME_DURATION) {
      end();
    }
  }

  function draw() {
    const line = $("field").clientHeight - 44;

    for (const note of chart) {
      const y =
        line - (note.time - time) * (line / 1.75);

      note.element.hidden =
        note.done || y < -15 || y > line + 32;

      if (!note.element.hidden) {
        note.element.style.transform =
          `translateY(${y - 6}px)`;
      }
    }

    if (time > judgeUntil) {
      $("judge").textContent = "";
    }

    metrics();
  }

  function frame(now) {
    if (state === "playing") {
      advance(now);

      if (state === "playing") {
        music();
      }

      draw();
    }

    requestAnimationFrame(frame);
  }

  function hit(lane) {
    if (state !== "playing") {
      return;
    }

    advance(performance.now());

    if (state !== "playing") {
      draw();
      return;
    }

    inputs += 1;

    const tolerance = mode === "A" ? 0.1 : 0.15;

    const note = chart.find((item) => {
      return (
        !item.done &&
        item.lane === lane &&
        Math.abs(item.time - time) <= tolerance
      );
    });

    if (note) {
      note.done = true;
      hits += 1;
      combo += 1;

      const perfect = Math.abs(note.time - time) <= 0.05;

      score += perfect ? 1000 : 700;
      announce(perfect ? "PERFECT" : "GOOD");

      flashPad(lane);

      const frequencies = [261.63, 329.63, 392, 523.25];
      tone(frequencies[lane], 0.09, "triangle");
    } else {
      combo = 0;
      announce("EMPTY");
    }

    draw();
  }

  function pause() {
    if (state === "playing") {
      advance(performance.now());

      if (state !== "playing") {
        draw();
        return;
      }

      setState("paused");
      stopAudio();
      clearFlashes();
      draw();

      $("overlayTitle").textContent = "잠깐, 숨 고르기";

      $("overlayText").textContent =
        "시간과 노트가 멈췄어요. 준비되면 이어가세요.";

      $("start").textContent = "이어서 플레이 ▶";
      $("overlay").hidden = false;
    } else if (state === "paused") {
      audioInit();

      lastTime = performance.now();
      setState("playing");

      $("overlay").hidden = true;
    }
  }

  $("start").onclick = () => {
    if (state === "paused") {
      pause();
    } else {
      start();
    }
  };

  $("restart").onclick = start;
  $("pause").onclick = pause;

  document.addEventListener("keydown", (event) => {
    const tagName = event.target?.tagName;

    if (
      ["INPUT", "TEXTAREA", "SELECT"].includes(tagName) ||
      event.target?.isContentEditable
    ) {
      return;
    }

    const lane = KEY_CODES.indexOf(event.code);
    const isPauseKey = event.code === "Space";

    if (lane >= 0 || isPauseKey) {
      event.preventDefault();

      if (event.repeat) {
        return;
      }

      if (lane >= 0) {
        hit(lane);
      } else {
        pause();
      }
    }
  });

  pads.forEach((pad, lane) => {
    pad.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      hit(lane);
    });

    // Enter로 버튼을 작동시키는 키보드 접근도 지원합니다.
    pad.addEventListener("click", (event) => {
      if (event.detail === 0) {
        hit(lane);
      }
    });
  });

  window.addEventListener("blur", () => {
    if (state === "playing") {
      pause();
    }
  });

  document.addEventListener("visibilitychange", () => {
    if (document.hidden && state === "playing") {
      pause();
    }
  });

  window.addEventListener("resize", () => {
    draw();
  });

  $("mode").onchange = () => {
    data.mode = $("mode").value;
    save();
  };

  $("sound").onchange = () => {
    data.sound = $("sound").checked;
    applySettings();

    if (!data.sound) {
      stopAudio();
    } else {
      audioInit();
    }

    save();
  };

  $("reduce").onchange = () => {
    data.reduce = $("reduce").checked;
    clearFlashes();
    applySettings();
    save();
  };

  function median(values) {
    const sorted = [...values].sort((a, b) => a - b);

    if (sorted.length === 0) {
      return 0;
    }

    const middle = Math.floor(sorted.length / 2);

    if (sorted.length % 2 === 1) {
      return sorted[middle];
    }

    return (sorted[middle - 1] + sorted[middle]) / 2;
  }

  function renderRecords() {
    const groups = ["A", "B"].map((groupMode) => {
      return data.records
        .filter((record) => record.mode === groupMode)
        .slice(0, 10);
    });

    $("aCount").textContent = groups[0].length;
    $("bCount").textContent = groups[1].length;

    $("summary").replaceChildren();

    groups.forEach((records, index) => {
      const paragraph = document.createElement("div");
      const hitValues = records.map((record) => record.hits);

      const range = records.length
        ? `${Math.min(...hitValues)}–${Math.max(...hitValues)}`
        : "—";

      const successCount = records.filter(
        (record) => record.success
      ).length;

      paragraph.textContent =
        `${index === 0 ? "A" : "B"} · ` +
        `${records.length}/10회 · ` +
        `적중 중앙값 ${median(hitValues)} · ` +
        `범위 ${range} · 성공 ${successCount}회`;

      $("summary").append(paragraph);
    });

    $("rows").replaceChildren();

    data.records.forEach((record, index) => {
      const row = document.createElement("tr");

      const cells = [
        index + 1,
        `${record.mode} ±${record.mode === "A" ? 100 : 150}ms`,
        record.score,
        "30.0초",
        `${record.hits}/${TOTAL_NOTES}`,
        record.success ? "성공" : "실패",
        record.cause
      ];

      for (const value of cells) {
        const cell = document.createElement("td");
        cell.textContent = value;
        row.append(cell);
      }

      $("rows").append(row);
    });

    if (data.records.length === 0) {
      const row = document.createElement("tr");
      const cell = document.createElement("td");

      cell.colSpan = 7;
      cell.textContent =
        "아직 완료한 플레이가 없습니다. 첫 판을 시작해 보세요.";

      row.append(cell);
      $("rows").append(row);
    }
  }

  function openRecords() {
    if (state === "playing") {
      pause();
    }

    $("records").hidden = false;

    $("records").scrollIntoView({
      behavior: data.reduce ? "auto" : "smooth"
    });
  }

  $("recordsToggle").onclick = openRecords;
  $("openRecords").onclick = openRecords;

  $("closeRecords").onclick = () => {
    $("records").hidden = true;
  };

  $("choice").value = data.choice;
  $("reason").value = data.reason;

  $("saveDecision").onclick = () => {
    data.choice = $("choice").value;
    data.reason = $("reason").value.slice(0, 2000);

    const saved = save();

    $("decisionStatus").textContent = saved
      ? "최종 판단을 저장했습니다."
      : "이번 방문 동안만 판단을 보관합니다. 기록을 내려받으세요.";
  };

  $("export").onclick = () => {
    const exportData = {
      game: "PULSE / 30",
      ...data
    };

    const blob = new Blob(
      [JSON.stringify(exportData, null, 2)],
      { type: "application/json;charset=utf-8" }
    );

    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");

    anchor.href = url;
    anchor.download = "pulse30-records.json";

    document.body.append(anchor);
    anchor.click();
    anchor.remove();

    setTimeout(() => {
      URL.revokeObjectURL(url);
    }, 1000);
  };

  $("reset").onclick = () => {
    if (state === "playing") {
      pause();
    }

    const accepted = window.confirm(
      "최고 점수, 플레이 기록, 설정과 최종 판단을 모두 초기화할까요?"
    );

    if (!accepted) {
      return;
    }

    data = defaults();
    const saved = save();

    resetRound();
    mode = data.mode;
    setState("ready");

    $("overlayTitle").textContent = "리듬을 시작할 시간";

    $("overlayText").textContent =
      "D · F · J · K 를 판정선에 맞춰 누르세요.";

    $("start").textContent = "플레이 시작 ▶";
    $("overlay").hidden = false;

    $("choice").value = "";
    $("reason").value = "";

    applySettings();
    renderRecords();

    $("decisionStatus").textContent = saved
      ? "저장 기록과 현재 판을 초기화했습니다."
      : "현재 화면은 초기화했지만 저장 공간에는 반영하지 못했습니다.";
  };

  $("selftest").onclick = () => {
    if (["playing", "paused"].includes(state)) {
      $("testResult").textContent =
        "진행 중인 판을 끝낸 뒤 검사하세요.";

      return;
    }

    const results = [];

    try {
      if (decode("").best !== 0) {
        throw new Error("빈 저장 기본값 오류");
      }

      results.push("PASS · 빈 저장 기본값");

      const brokenValues = [
        "{broken",
        "null",
        '{"version":1}',
        '{"version":99}'
      ];

      for (const raw of brokenValues) {
        let caught = false;

        try {
          decode(raw);
        } catch {
          caught = true;
        }

        if (!caught) {
          throw new Error("손상 저장 감지 실패");
        }
      }

      results.push("PASS · 손상 저장 감지");

      start();

      const inputStart = performance.now();

      for (let index = 0; index < 10; index += 1) {
        document.dispatchEvent(
          new KeyboardEvent("keydown", {
            code: "KeyD",
            bubbles: true
          })
        );
      }

      const inputElapsed = performance.now() - inputStart;

      if (inputs !== 10) {
        throw new Error(`입력 처리 수: ${inputs}`);
      }

      if (inputElapsed > 1000) {
        throw new Error("입력 검사 시간이 1초를 초과했습니다.");
      }

      results.push(
        "PASS · 1초 내 입력 이벤트 10건 → 핵심 입력 처리 10회"
      );

      document.dispatchEvent(
        new KeyboardEvent("keydown", {
          code: "KeyD",
          repeat: true,
          bubbles: true
        })
      );

      if (inputs !== 10) {
        throw new Error("키 자동 반복 제외 실패");
      }

      results.push("PASS · 키 자동 반복 제외");

      pause();

      const pausedTime = time;
      advance(performance.now() + 600000);

      if (time !== pausedTime) {
        throw new Error("일시정지 중 시간이 진행되었습니다.");
      }

      results.push(
        "PASS · 일시정지 시간 고정 — 모의 시각 검사"
      );

      results.push(
        "미검사 · 실제 10분 실행 / 브라우저 콘솔 / 두 해상도 / 시크릿 접근"
      );
    } catch (error) {
      results.push(`FAIL · ${error.message}`);
    } finally {
      resetRound();
      setState("ready");

      $("overlayTitle").textContent = "검사 종료";

      $("overlayText").textContent =
        "검사 결과는 기록 화면에서 확인하세요. 검사 플레이는 저장하지 않습니다.";

      $("start").textContent = "플레이 시작 ▶";
      $("overlay").hidden = false;

      $("testResult").textContent = results.join("\n");
    }
  };

  // 지원하는 브라우저에서만 현재 게임 상태를 읽는 도구를 등록합니다.
  const modelContext = document.modelContext;

  if (modelContext?.registerTool) {
    try {
      Promise.resolve(
        modelContext.registerTool({
          name: "read_rhythm_session",

          description:
            "현재 리듬게임 상태와 완료 기록 수를 읽습니다.",

          inputSchema: {
            type: "object",
            properties: {},
            additionalProperties: false
          },

          annotations: {
            readOnlyHint: true
          },

          execute: (argument) => {
            if (
              !argument ||
              typeof argument !== "object" ||
              Array.isArray(argument) ||
              Object.keys(argument).length > 0
            ) {
              throw new Error("입력은 빈 객체여야 합니다.");
            }

            return {
              state,
              time,
              score,
              hits,
              mode,
              records: data.records.length
            };
          }
        })
      ).catch(() => {
        // 선택 기능의 실패는 게임 실행을 중단하지 않습니다.
      });
    } catch {
      // 해당 기능을 지원하지 않는 환경에서도 게임은 실행됩니다.
    }
  }

  applySettings();
  renderRecords();
  metrics();
  requestAnimationFrame(frame);
})();
